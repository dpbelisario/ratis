{
  "kind": "Dashboard",
  "metadata": {
    "name": "ozone-rpc",
    "project": "ozone"
  },
  "spec": {
    "display": {
      "name": "Ozone RPC"
    },
    "duration": "30m",
    "refreshInterval": "10s",
    "variables": [],
    "panels": {
      "intro": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Read me"
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "**Ozone incident lab** (Ozone 2.0.0, 3 OM + 3 SCM, lab RPC capacity 1:200).\n\nHow to read: a full OM queue alone does not mean failure. Check **completed calls/s**:\nhigh = busy, near 0 = stuck. Then check SCM 9863 (row 2): if SCM is slow, OM handlers wait on SCM.\nRow 3 follows a delete from OM to SCM. Row 4 shows if the SCM state machine keeps up.\n"
            }
          }
        }
      },
      "p1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Lab clock (hour)",
            "description": "realtime profile: JST hour. accel profile: virtual hour (1 real minute = 1 lab hour)."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "lab_clock_hour",
                    "seriesNameFormat": "{{profile}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Jobs running (1 = running)",
            "description": "job01 = 01:00 bulk delete, job10 = 10:00 write burst, seed = pre-load."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "lab_job_running",
                    "seriesNameFormat": "{{task}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p3": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Fault active, writer on, writer clients alive",
            "description": "Writer clients pile up when OM does not answer (each client = 5 threads)."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "lab_fault_active",
                    "seriesNameFormat": "fault active"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "lab_writer_on",
                    "seriesNameFormat": "writer on"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "lab_writer_clients",
                    "seriesNameFormat": "writer clients"
                  }
                }
              }
            }
          ]
        }
      },
      "p4": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "OM call queue length",
            "description": "Calls waiting for a handler. Lab limit = 5 handlers x 10 = 50 (production 100 x 100 = 10K)."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rpc_call_queue_length{job=\"ozone-om\",port=\"9862\"}",
                    "seriesNameFormat": "{{hostname}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p5": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "OM busy handlers",
            "description": "Handlers that are working on a call now. All busy + full queue = saturated."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rpc_num_in_process_handler{job=\"ozone-om\",port=\"9862\"}",
                    "seriesNameFormat": "{{hostname}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p6": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "OM completed calls/s",
            "description": "Busy = high rate. Stuck = rate near 0 while the queue is full."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rate(rpc_rpc_processing_time_num_ops{job=\"ozone-om\",port=\"9862\"}[1m])",
                    "seriesNameFormat": "{{hostname}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p7": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "OM avg queue time and processing time (ms)",
            "description": "Queue time grows first when handlers are slow. Processing time is the time inside the handler (includes waits on SCM)."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rpc_rpc_queue_time_avg_time{job=\"ozone-om\",port=\"9862\"}",
                    "seriesNameFormat": "queue {{hostname}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rpc_rpc_processing_time_avg_time{job=\"ozone-om\",port=\"9862\"}",
                    "seriesNameFormat": "proc {{hostname}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p8": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "OM open connections",
            "description": "Open TCP connections are not requests. Compare with the queue."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rpc_num_open_connections{job=\"ozone-om\",port=\"9862\"}",
                    "seriesNameFormat": "{{hostname}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p9": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "OM log: SCM retry / failover / not-leader lines per minute",
            "description": "Counted from the OM logs by the lab scheduler (production: grep the OM log). Retries come after hdds.scmclient.rpc.timeout (15m) or a 'not leader' answer."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rate(lab_om_failover_log_lines_total[5m]) * 60",
                    "seriesNameFormat": "OM log lines/min"
                  }
                }
              }
            }
          ]
        }
      },
      "p10": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "OM client backoff and dropped connections /s",
            "description": "Backoff happens when the call queue is full (backoff must be enabled)."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rate(rpc_rpc_client_backoff{job=\"ozone-om\",port=\"9862\"}[1m])",
                    "seriesNameFormat": "backoff {{hostname}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rate(rpc_num_dropped_connections{job=\"ozone-om\",port=\"9862\"}[1m])",
                    "seriesNameFormat": "dropped {{hostname}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p11": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "SCM 9863 call queue length",
            "description": "Production climbed in a straight line to 2.4K. Straight line = arrivals at a fixed rate, almost nothing completes."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rpc_call_queue_length{job=\"ozone-scm\",servername=\"ScmBlockLocationProtocolService\"}",
                    "seriesNameFormat": "{{hostname}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p12": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "SCM 9863 busy handlers",
            "description": "Lab limit = 5."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rpc_num_in_process_handler{job=\"ozone-scm\",servername=\"ScmBlockLocationProtocolService\"}",
                    "seriesNameFormat": "{{hostname}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p13": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "SCM 9863 completed calls/s",
            "description": "Only the SCM leader does real work. Followers answer 'not leader'."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rate(rpc_rpc_processing_time_num_ops{job=\"ozone-scm\",servername=\"ScmBlockLocationProtocolService\"}[1m])",
                    "seriesNameFormat": "{{hostname}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p14": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "SCM 9863 avg queue time and processing time (ms)",
            "description": ""
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rpc_rpc_queue_time_avg_time{job=\"ozone-scm\",servername=\"ScmBlockLocationProtocolService\"}",
                    "seriesNameFormat": "queue {{hostname}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rpc_rpc_processing_time_avg_time{job=\"ozone-scm\",servername=\"ScmBlockLocationProtocolService\"}",
                    "seriesNameFormat": "proc {{hostname}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p15": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "SCM 9863 queue growth (calls per minute)",
            "description": "Slope of the queue. If SCM handlers do not finish, the OM times out after hdds.scmclient.rpc.timeout and sends the call again, so the slope = OM handlers / rpc timeout (production 100 / 15 min = 6.7/min = 400/h)."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "deriv(rpc_call_queue_length{job=\"ozone-scm\",servername=\"ScmBlockLocationProtocolService\"}[5m]) * 60",
                    "seriesNameFormat": "{{hostname}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p16": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "SCM block protocol calls/s by type",
            "description": "AllocateScmBlock = writes. DeleteScmKeyBlocks = the OM KeyDeletingService sends deleted keys' blocks."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (hostname, type) (rate(scm_block_location_protocol_counter[1m])) > 0",
                    "seriesNameFormat": "{{hostname}} {{type}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p17": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "SCM block protocol avg time per call by type (ms)",
            "description": "time / count, per type. A slow DeleteScmKeyBlocks holds a 9863 handler for that long."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (hostname, type) (rate(scm_block_location_protocol_time[1m])) / sum by (hostname, type) (rate(scm_block_location_protocol_counter[1m])) > 0",
                    "seriesNameFormat": "{{hostname}} {{type}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p18": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "OM key deletes/s (user deletes)",
            "description": "The 01:00 job shows here."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rate(om_metrics_num_key_deletes[1m])",
                    "seriesNameFormat": "{{hostname}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p19": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "OM deletedTable keys (estimate)",
            "description": "Keys deleted by users but whose blocks are not yet handed to SCM. This is the OM-side 'pending delete' backlog."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rocksdb_om_db_deletedtable_estimate_num_keys",
                    "seriesNameFormat": "{{hostname}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p20": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "KeyDeletingService keys sent for purge / purged per s",
            "description": "Runs every ozone.key.deleting.service.interval, at most ozone.key.deleting.limit.per.task keys per run."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rate(deleting_service_metrics_num_keys_sent_for_purge[1m])",
                    "seriesNameFormat": "sent {{hostname}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rate(deleting_service_metrics_num_keys_purged[1m])",
                    "seriesNameFormat": "purged {{hostname}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p21": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "KeyDeletingService run latency (ms)",
            "description": ""
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "om_performance_metrics_key_deleting_service_latency_ms",
                    "seriesNameFormat": "{{hostname}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p22": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "FSO: DirectoryDeletingService (files moved to deletedTable /s, dirs purged /s)",
            "description": "An FSO directory delete is 1 key delete in om_metrics_num_key_deletes. The files move to deletedTable here, every ozone.directory.deleting.service.interval (60s)."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rate(deleting_service_metrics_num_sub_files_moved_to_deleted_table[1m])",
                    "seriesNameFormat": "files {{hostname}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rate(deleting_service_metrics_num_dirs_purged[1m])",
                    "seriesNameFormat": "dirs {{hostname}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rocksdb_om_db_deleteddirectorytable_estimate_num_keys",
                    "seriesNameFormat": "deletedDirectoryTable {{hostname}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p23": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "SCM deletedBlocks table (deleted block log, estimate)",
            "description": "Transactions written by DeleteScmKeyBlocks through SCM Ratis. Drains when datanodes confirm deletes."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rocksdb_scm_db_deletedblocks_estimate_num_keys",
                    "seriesNameFormat": "{{hostname}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p24": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "SCM block deleting service transactions/s",
            "description": "created = added to the log, sent = sent to datanodes, completed = datanodes confirmed."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rate(scm_block_deleting_service_num_block_deletion_transaction_created[1m])",
                    "seriesNameFormat": "created {{hostname}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rate(scm_block_deleting_service_num_block_deletion_transaction_sent[1m])",
                    "seriesNameFormat": "sent {{hostname}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rate(scm_block_deleting_service_num_block_deletion_transaction_completed[1m])",
                    "seriesNameFormat": "completed {{hostname}}"
                  }
                }
              }
            }
          ]
        }
      },
      "p25": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "SCM Ratis apply lag (entries)",
            "description": "Highest commit index minus each node's applied index. Growth = the state machine cannot keep up."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "scalar(max(ratis_server_peerCommitIndex{job=\"ozone-scm\"})) - ratis_state_machine_applyCompletedIndex{job=\"ozone-scm\"}",
