# Profile "accel": 1 real minute = 1 lab hour (60x). Same 1:200 delete pacing as realtime,
# and every background-service interval is divided by 60 so the delete backlog drains
# in the same number of lab hours.
OZONE-SITE.XML_ozone.key.deleting.limit.per.task=100
OZONE-SITE.XML_hdds.scm.block.deletion.per-interval.max=500
OZONE-SITE.XML_hdds.datanode.block.deleting.limit.per.interval=25
# 1m -> 1s  (OM KeyDeletingService and datanode BlockDeletingService)
OZONE-SITE.XML_ozone.block.deleting.service.interval=1s
# 1m -> 1s  (OM DirectoryDeletingService, FSO buckets)
OZONE-SITE.XML_ozone.directory.deleting.service.interval=1s
# 60s -> 1s (SCM sends delete commands to datanodes)
OZONE-SITE.XML_hdds.scm.block.deleting.service.interval=1s
# 600s -> 10s (SCM HA flushes its transaction buffer, incl. the deleted block log, to RocksDB)
OZONE-SITE.XML_ozone.scm.ha.dbtransactionbuffer.flush.interval=10s
# 30s -> 1s (datanode heartbeat; delete commands travel on heartbeat responses)
OZONE-SITE.XML_hdds.heartbeat.interval=1s
# 15m -> 15s (OM -> SCM RPC timeout; after it the OM retries/fails over while the old call
# may still sit in the SCM queue)
OZONE-SITE.XML_hdds.scmclient.rpc.timeout=15s
